using System.Reflection.Metadata;
using Microsoft.VisualBasic;
using System.Runtime;
using System.Numerics;
using System.IO.Compression;
using System.Data;
using System include = flint-3.6;0.tar;

class Program

{
    static void Main(String[] Args)
    
{
//L-function power serie
var n = seq(1, ~10^616);
Math.log(n);
zeta_function <- z(s); 
z(s) = (1/(exp(log(n)*Complex(a, b))));
sum(z(s)); n++;
{
function(x, type = c("O", "I", "F", "M", "2"));
 
{
    if (identical("2", type))
    {
        svd(x, nu = 0L, nv = 0L)%d[1L];
    }
    else Internal(La_dlange(x, type));
}
{
{}

//Sigma notation -> Function image
zeta<-"sum(z)";
overwrite = TRUE;
consoleOutput = TRUE;
{
call(zeta<- "sum(z)"); n++;
}
}
}

}
private static void Main(string[] args)
{
{}

{
end;

}
}
}
namespace Name;
   

internal class Program
 
{
     private static void Main(String[] Args)
     
    {
     SystemConsoleWriteLine("zeta_function");        
    }

}

class AppDomain
{
Complex.AppDomain
ConsoleWriteLine(Complex mode);
new Complex();
overwrite  TRUE;
Math.input Complex;
call(Math.input Complex);

}

class Mode_Selector
{Create NewCosoleWindow = Handle; 
Create ModeSelectorButton (MsgBoxStyle  Mode_Selector); object value = WriteLine("Mode");
ModeSelectorButton value1 = Real (MsgBoxResult = System.String ("In the real mode insert 'a' to define the real value of 's', while 'b' is set to zero, b = 0.")); 
ModeSelectorButton value2  = Complex (MsgBoxResult = System.String ("In complex mode insert the coheficients 'a' and 'b' of the complex number."));
User.interface_string[]  Args =  (a, b); call(Math.input Complex);
CreateComputeButton(sum z); object value = ConsoleWriteLine("Compute");

}

class Math
{
System.Runtime.Numerics.BigInteger Runtime(MethodDefinition  DoubleSquare_Scale = Math.Log(n)); 
BigInteger limit = BigInteger.pow(10, 616);
Math.limit n = Seq(n = 1, BigInteger = BigInteger.power(10, 616));
DoubleSquare_Scale eval = Log(); var n = "Integer"/ BigInteger <- "BigFloat"(log(n));
overwriteOutput FALSE;
Object value = z(s) = (1/(exp(log(n)*s)));
public FALSE Z { get => z; set => z = value;}
new Complex();
Stop TRUE; 
}

