ModeSelectorButton value1 = Real (MsgBoxResult = System.String ("In the real mode insert 'a' to define the real value of 's', while 'b' is set to zero, b = 0.")); 
ModeSelectorButton value2  = Complex (MsgBoxResult = System.String ("In complex mode insert the coheficients 'a' and 'b' of the complex number."));
