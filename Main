class Math
{
System.Runtime.Numerics.BigInteger Runtime(MethodDefinition  DoubleSquare_Scale = Math.Log(n)); 
BigInteger limit = BigInteger.pow(10, 616);
Math.limit n = Seq(n = 1, BigInteger = BigInteger.power(10, 616));
DoubleSquare_Scale  eval = Log(); var n = "Integer"/ BigInteger <- "BigFloat"(log(n));
overwriteOutput FALSE;
Object value = z(s) = (1/(exp(log(n)*s)));

public FALSE Z { get => z; set => z = value;}
Stop TRUE; 

}
